{
  "manifest_version": 3,
  "name": "MiMo Web2API Helper",
  "version": "1.2.0",
  "key": "",
  "description": "一键将 MiMo 登录态同步到本机 MiMo Web2API 网关；同一账号重复同步只更新，不新增",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.xiaomimimo.com/*",
    "https://*.xiaomi.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
